# Salin file ini menjadi .env dan isi nilai lokal Anda.
# JANGAN PERNAH commit file .env ke Git.

# Local or Remote LLM Endpoint (Optional)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=replace-with-local-or-provider-key
LLM_MODEL=replace-with-model-id

# Application Environment
NODE_ENV=development
APP_PORT=3000
